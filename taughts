AFTERNOON THUNDERSTORM DETECTOR:
  = min(
    membership(temp_max, sigmoid, center=28°C),         // hot day
    membership(temp_amplitude, sigmoid, center=13°C),   // strong diurnal swing
    membership(humidity_min, sigmoid, center=45%),      // enough moisture
    membership(gust_factor, sigmoid, center=2.5),       // gusty
    membership(precip_intensity, sigmoid, center=3mm/h),// heavy burst
    seasonal_weight(summer=1.0, spring=0.5, autumn=0.4, winter=0.05)
  )
PERSISTENT ANTICYCLONIC GLOOM (winter stratus):
  = min(
    membership(sunshine_fraction, reverse_sigmoid, center=0.15), // no sun
    membership(temp_amplitude, reverse_sigmoid, center=4°C),     // flat temp
